# =====================================================================
# Bot de scalping pe aur (XAUUSD) cu Claude — configurare. NU publica acest fișier completat.
# Secretele (chei, tokenuri) rămân doar pe server, niciodată în frontend.
# =====================================================================

# --- Aplicație ---
APP_ENV=development
# Singurul profil: aur 24/5, o decizie Claude la fiecare bară M1 închisă. Fixează simbolul, cadrul M1 și limitele de risc
# peste valorile de mai jos și peste setările salvate din dashboard.
PROFILE=gold_basket
HOST=127.0.0.1
PORT=8787
# Token de administrare: necesar pentru orice acțiune din dashboard (pornire/oprire bot, închidere poziții, setări).
# Generează unul cu: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# --- MetaTrader 5 ---
DATA_SOURCE=mt5_bridge
# Cheie partajată cu EA-ul (aceeași valoare în inputul InpBridgeKey al EA-ului AIBridgeEA)
MT5_BRIDGE_KEY=
# Magic number pentru pozițiile botului (pozițiile cu alt magic nu sunt atinse niciodată)
MT5_MAGIC=552211
# Baza de date SQLite. Ține-o în afara folderelor sincronizate cu iCloud (fișierele evacuate blochează serverul).
DATABASE_PATH=data/bot.db
DEFAULT_TIMEZONE=Europe/Chisinau

# --- Mod de tranzacționare ---
# PAPER = simulator intern; DEMO = ordine reale în contul MT5 conectat (demo sau real)
TRADING_MODE=DEMO
EXECUTION_ENABLED=true
LIVE_TRADING_ALLOWED=true
PAPER_START_BALANCE=10000

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
# modelul pentru decizii (intrări, ieșiri, investigații)
CLAUDE_MODEL=claude-opus-5-5
# modelul ieftin pentru barele de rutină (gol = același model peste tot)
BASKET_CLAUDE_FLAT_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=30

# --- Coșul Claude (app/basket.py) ---
# TP și SL fixe la broker pe fiecare intrare, în USD de preț (1 USD de preț = 1 USD pe 0.01 lot)
BASKET_SCALP_TP_PRICE=1.5
BASKET_SCALP_SL_PRICE=4.0
# limita de pierdere a grupului la 0.01 lot (valoarea din dashboard are prioritate); crește cu lotul de start
BASKET_MAX_LOSS_USD=40
# lotul maxim pe poziție și numărul maxim de poziții pe care le poate deschide Claude
CLAUDE_MAX_LOT=0.5
BASKET_MAX_POSITIONS_CLAUDE=8
# CLOSE pe minus refuzat cât timp poziția are sub atâtea minute (SL-ul fix lucrează)
BASKET_CLAUDE_LOSS_CLOSE_MIN_MINUTES=10
# după atâtea pierderi la rând pe o parte, nicio reintrare pe acea parte în zona lor atâtea minute
BASKET_ZONE_BLOCK_LOSSES=2
BASKET_ZONE_BLOCK_MINUTES=90
