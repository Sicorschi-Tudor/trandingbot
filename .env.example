# =====================================================================
# MT5 AI Trading Bot — configurare (v1). NU publica acest fișier completat.
# Secretele (chei, tokenuri) rămân doar pe server, niciodată în frontend.
# =====================================================================

# --- Aplicație ---
APP_ENV=development
# Adresa/portul serverului web (dashboard + API + bridge EA)
HOST=127.0.0.1
PORT=8787
# Token de administrare: necesar pentru orice acțiune (mod, armare, close-all, setări).
# Generează unul cu: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# --- Sursa de date ---
# mt5_bridge = date reale de la EA-ul din MetaTrader 5; sim = feed SIMULAT (doar pentru test, fără DEMO)
DATA_SOURCE=mt5_bridge
# Cheie partajată cu EA-ul (aceeași valoare în inputul InpBridgeKey al EA-ului)
MT5_BRIDGE_KEY=
# Magic number pentru pozițiile botului (pozițiile cu alt magic nu sunt atinse niciodată)
MT5_MAGIC=552211
DATABASE_PATH=data/bot.db
# Arhivă istoric bare (EA v1.11+): descarcă treptat ultimele ARCHIVE_DAYS zile pentru backtest și etichetare
ARCHIVE_ENABLED=true
ARCHIVE_DAYS=120
ARCHIVE_BATCH_BARS=5000
# Istoric extins pe TF mari (după setul de bază, doar pentru cercetare): TF:zile separate prin virgulă; off = dezactivat
# (implicit). Exemplu pentru Etapa C2: ARCHIVE_EXTRA=H1:1095,H4:1825,D1:3650
# Pauză de ARCHIVE_EXTRA_INTERVAL_S secunde după fiecare răspuns la o cerere extinsă (MT5 poate bloca EA-ul cât descarcă
# istoricul); cererile extinse așteaptă cât botul are poziții deschise
ARCHIVE_EXTRA=off
ARCHIVE_EXTRA_INTERVAL_S=60
# true = descarcă istoricul lung și cu poziții ale botului deschise (MT5 se poate bloca scurt)
ARCHIVE_EXTRA_WITH_POSITIONS=false
# Simboluri DOAR pentru cercetare: arhivate pe D1/H4/H1 (zilele din ARCHIVE_EXTRA, aceeași pauză), DUPĂ ce simbolurile
# active sunt complete. Nu sunt niciodată analizate, cotate sau tranzacționate. Necesită ARCHIVE_EXTRA activ și EA v1.13+.
# Numele diferă între brokeri: serverul încearcă variante (US500 -> SPX500, US500.cash, SP500; DE40 -> GER40, DAX40 ...).
# off = dezactivat
RESEARCH_SYMBOLS=XAUUSD,XAGUSD,US500,US30,NAS100,UK100,DE40,JP225,XTIUSD,XBRUSD,BTCUSD,ETHUSD,USDCHF,USDMXN,USDZAR,USDTRY
# Regula DST a orei serverului brokerului pentru barele din arhivă (EA v1.12+): auto | EET | NY | fixed | zonă IANA
# auto: detectează EET (schimbare UE) sau NY (închidere New York, GMT+2/+3); fixed = brokerul nu schimbă ora
MT5_SERVER_TZ=auto
# Teste forward (PAPER, SIMULAT — nu trimit niciodată ordine în MT5 și nu schimbă deciziile live): listă JSON.
# Câmpuri: name, strategy (plugin sau fade-v1 = oglinda trend-v1), signal_tf (H1), htf_tf (H4), symbols ("active" sau
# listă), risk_pct (0.5), equity (200), criteria {min_trades:100, max_weeks:8, ci_lower_gt:-0.05, avg_r_gt:0, pf_gt:1.15}.
# Cheia de setări 'forward_tests' (dacă există) are prioritate. Exemplu:
# FORWARD_TESTS=[{"name":"fade-v1-H1","strategy":"fade-v1","signal_tf":"H1","htf_tf":"H4","symbols":"active"}]
FORWARD_TESTS=[]

# --- ML (învățare separată de tranzacționare; spec §6.4) ---
# Modelele noi pornesc în UMBRĂ: doar înregistrează decizii, nu tranzacționează niciodată.
# Un model acționează DOAR după aprobare manuală (pagina Modele ML, token admin + „APROB”).
ML_ENABLED=true
# Model de intrare aprobat: factor de risc între ML_SIZE_MIN și ML_SIZE_MAX (max 2.0); limitele Risk Engine rămân
ML_SIZE_MIN=0.5
ML_SIZE_MAX=1.0
# Risc maxim (% din equity) pentru o tranzacție mărită de ML (factor > 1)
ML_MAX_RISK_PCT=0.5
# Reantrenare nocturnă (ora locală DEFAULT_TIMEZONE), într-un subproces cu prioritate redusă, pe o copie a bazei
ML_RETRAIN_ENABLED=true
ML_RETRAIN_AT=22:30
ML_RETRAIN_TIMEOUT_MIN=120
ML_RETRAIN_ARGS=train --db {db} --out {models_dir} --registry-db {db}
ML_MODELS_DIR=data/models
ML_DECISIONS_MAX_ROWS=200000

# --- Program (fereastra de tranzacționare) ---
# Fus orar IANA; ora de vară/iarnă se aplică automat
DEFAULT_TIMEZONE=Europe/Chisinau
SESSION_ENABLED=true
SESSION_START=09:00
SESSION_END=13:00
SESSION_DAYS=MON,TUE,WED,THU,FRI

# --- Instrumente și timeframe-uri ---
# Simboluri separate prin virgulă, exact ca în MT5 (ex.: EURUSD,GBPUSD,XAUUSD)
ACTIVE_SYMBOLS=EURUSD
SIGNAL_TIMEFRAME=M5
HTF_TIMEFRAME=H1
CHART_TIMEFRAMES=M1,M5,M15,H1

# --- Mod de tranzacționare ---
# SIGNAL_ONLY | PAPER | DEMO   (LIVE este refuzat în v1)
TRADING_MODE=PAPER
# Execuția automată pornește dezarmată; o armezi din dashboard
EXECUTION_ENABLED=false
LIVE_TRADING_ALLOWED=false
MUST_HAVE_SL_TP=true

# --- Limite de risc (Risk Engine determinist) ---
MAX_RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_EQUITY_DRAWDOWN_PCT=3.0
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=3
MAX_SPREAD_POINTS=30
MAX_SLIPPAGE_POINTS=20
MAX_VOLUME_LOTS=0.05
MAX_SAME_CURRENCY_DIRECTION=1
MIN_FREE_MARGIN_PCT=50
MAX_TICK_AGE_SECONDS=10
MAX_SIGNALS_PER_SYMBOL_PER_SESSION=5
# Blocare intrări în jurul știrilor economice (minute înainte/după; 0 = dezactivat)
NEWS_BLACKOUT_MINUTES=30
# Importanța minimă a știrii care blochează: 1 = scăzută, 2 = moderată, 3 = mare
NEWS_MIN_IMPORTANCE=3
# Risc total deschis maxim (poziții deschise + tranzacția nouă), % din equity
MAX_TOTAL_OPEN_RISK_PCT=2.0
# Pauză după seria de pierderi consecutive (minute de la ultima pierdere; 0 = tot restul zilei)
LOSS_STREAK_PAUSE_MINUTES=90
# Pauză pe simbol după o tranzacție a botului închisă pe pierdere (minute; 0 = dezactivat)
COOLDOWN_AFTER_LOSS_MINUTES=30
# Fără intrări noi în ±N minute în jurul rollover-ului de la 17:00 America/New_York (cu ora de vară; 0 = dezactivat)
ROLLOVER_BLACKOUT_MINUTES=20

# --- Strategie trend-v1 ---
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5
MIN_SL_POINTS=60
MIN_SCORE_COMPONENTS=4
SIGNAL_EXPIRY_MINUTES=15
BREAK_EVEN_AT_R=1.0
# La break-even SL = intrare ± max(spread curent + 3 puncte, BE_LOCK_R × riscul inițial); 0 = intrare ± 2 puncte
BE_LOCK_R=0.1
TRAILING_ENABLED=false
MAX_HOLD_MINUTES=240
CLOSE_AT_SESSION_END=true
# Ieșire „rescue”: după RESCUE_MINUTES deschisă, cu MAE ≥ RESCUE_MAE_R și cel puțin RESCUE_NEG_FRAC din minute
# pe minus, poziția se închide la primul profit ≥ RESCUE_CLOSE_R (motiv RESCUE; SL-ul nu este mutat)
RESCUE_ENABLED=true
RESCUE_MINUTES=30
RESCUE_MAE_R=0.3
RESCUE_NEG_FRAC=0.6
RESCUE_CLOSE_R=0.1
# Sold inițial al contului PAPER (simulat)
PAPER_START_BALANCE=10000

# --- Claude (Anthropic) — explică semnalul și poate da VETO; nu creează ordine ---
# Cheia API de la https://console.anthropic.com (o adaugi tu aici)
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_VETO_ENABLED=true
# true = fără răspuns Claude nu se tranzacționează
CLAUDE_REQUIRED=false
CLAUDE_TIMEOUT_SECONDS=45
# Profunzimea raționamentului la fiecare apel Claude: low | medium | high | xhigh | max (cost și durată cresc cu nivelul)
CLAUDE_REVIEW_EFFORT=medium
# Claude ca analist de tranzacții: analiză după fiecare tranzacție închisă + bilanț zilnic la sfârșitul sesiunii.
# Doar analiză (lecții, tipare, ipoteze de testat) — nu modifică niciodată setări, niveluri sau ordine.
CLAUDE_TRADE_REVIEW_ENABLED=true
CLAUDE_DAILY_REVIEW_ENABLED=true

# --- Telegram (botul tău existent) ---
TELEGRAM_ENABLED=false
# Token de la BotFather (doar aici, pe server)
TELEGRAM_BOT_TOKEN=
# ID-ul grupului (de obicei începe cu -100...)
TELEGRAM_CHAT_ID=
# Opțional: ID-ul topicului dintr-un supergrup cu forum
TELEGRAM_MESSAGE_THREAD_ID=
# URL public HTTPS al dashboardului pentru butonul „Deschide semnalul” (http local = fără buton)
PUBLIC_APP_URL=http://127.0.0.1:8787
